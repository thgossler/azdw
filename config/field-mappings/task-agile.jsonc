{
  "$schema": "./field-mapping-schema.json",
  
  // Default field mappings for Agile process template - Task
  // Auto-generated field mapping
  // 
  // This file defines how logical work item types and fields are mapped to
  // the physical Azure DevOps Agile process template fields.

  "processTemplate": "Agile",
  "logicalType": "Task", 
  "physicalType": "Task",
  
  // State mapping: maps physical states to logical states
  "stateMapping": {
