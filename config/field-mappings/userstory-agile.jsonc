    "AcceptanceCriteria": "Microsoft.VSTS.Common.AcceptanceCriteria",
    "BusinessValue": "Microsoft.VSTS.Common.BusinessValue",
    "Risk": "Microsoft.VSTS.Common.Risk",
    "TimeCriticality": "Microsoft.VSTS.Common.TimeCriticality",
    "ValueArea": "Microsoft.VSTS.Common.ValueArea"
  },

  // Required fields that must be present in work items of this type
  "requiredFields": [
    "System.Title",
    "System.State", 
    "System.WorkItemType"
  ],

  // Optional fields that may be present but are not required
  "optionalFields": [
    "Microsoft.VSTS.Scheduling.StoryPoints",
    "Microsoft.VSTS.Common.AcceptanceCriteria",
    "Microsoft.VSTS.Common.BusinessValue",
    "Microsoft.VSTS.Common.Risk",
    "Microsoft.VSTS.Common.TimeCriticality",
    "Microsoft.VSTS.Common.ValueArea"
  ],

  // Default values for fields when not present in the source work item
  "defaultValues": {
    "Priority": "Medium",
    "Risk": "Low", 
    "ValueArea": "Business"
  },

  // Human-readable comments explaining mapping decisions
  "configurationComments": "Default Agile process template mapping for User Story work items. This mapping preserves the standard Agile template field structure while providing logical abstractions for cross-template compatibility.",

