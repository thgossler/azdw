{
  "$schema": "./report-template-schema.json",
  "id": "team-dashboard-scriban-html",
  "name": "Team Dashboard (Scriban HTML)",
  "description": "Scriban-based HTML dashboard showing team progress with charts",
  "engineType": "scriban",
  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{{ parameters.team_name }} Dashboard</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Merriweather:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            --bg-primary: #F5F5F0;\n            --bg-card: #FAFAF8;\n            --bg-card-hover: #FFFFFF;\n            --text-primary: #1A1A1A;\n            --text-secondary: #5C5C5C;\n            --text-muted: #8C8C8C;\n            --accent-coral: #D97757;\n            --accent-coral-hover: #C4613F;\n            --accent-coral-light: rgba(217, 119, 87, 0.1);\n            --border-light: #E5E5E0;\n            --border-medium: #D4D4CF;\n        }\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: 'Merriweather', Georgia, serif; background: var(--bg-primary); color: var(--text-primary); padding: 40px 20px; line-height: 1.6; }\n        .container { max-width: 1200px; margin: 0 auto; }\n        .hero { text-align: center; padding: 40px 0 50px; }\n        .hero-icon { font-size: 2.5em; margin-bottom: 16px; }\n        .hero h1 { font-size: 2.2em; font-weight: 600; color: var(--text-primary); margin-bottom: 12px; letter-spacing: -0.02em; }\n        .hero p { font-size: 1.1em; color: var(--text-secondary); max-width: 500px; margin: 0 auto; }\n        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px; }\n        .stat-card { background: var(--bg-card); border: 1px solid var(--border-light); padding: 24px 20px; border-radius: 12px; text-align: center; }\n        .stat-value { font-size: 2em; font-weight: 600; color: var(--accent-coral); margin-bottom: 4px; }\n        .stat-label { font-size: 0.85em; color: var(--text-secondary); }\n        .section { margin-bottom: 32px; }\n        .section h2 { font-size: 1.4em; font-weight: 600; color: var(--text-primary); margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }\n        .card { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 12px; padding: 24px; }\n        table { width: 100%; border-collapse: collapse; }\n        th, td { padding: 12px 8px; text-align: left; border-bottom: 1px solid var(--border-light); }\n        th { background: var(--bg-card); font-weight: 600; color: var(--text-secondary); font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.03em; }\n        tr:hover { background: var(--bg-card-hover); }\n        td a { color: var(--accent-coral); text-decoration: none; font-weight: 500; }\n        td a:hover { text-decoration: underline; }\n        .footer { border-top: 1px solid var(--border-light); padding: 40px 0; text-align: center; margin-top: 40px; }\n        .info-block, .azdw-signature { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 12px; padding: 24px 32px; font-family: 'SF Mono', Monaco, monospace; font-size: 0.85em; line-height: 1.5; color: var(--text-secondary); text-align: left; white-space: pre-wrap; display: inline-block; }\n        .info-block a, .azdw-signature a { color: var(--accent-coral); text-decoration: none; }\n        .info-block a:hover, .azdw-signature a:hover { text-decoration: underline; }\n        @media (max-width: 768px) {\n            body { padding: 20px 16px; }\n            .hero h1 { font-size: 1.8em; }\n            .stats { grid-template-columns: repeat(2, 1fr); }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"hero\">\n            <div class=\"hero-icon\">\ud83d\udcca</div>\n            <h1>{{ parameters.team_name }} Dashboard</h1>\n            <p>Generated: {{ timestamp | format_date 'yyyy-MM-dd HH:mm:ss UTC' }}</p>\n        </div>\n        <div class=\"stats\">\n            <div class=\"stat-card\">\n                <div class=\"stat-value\">{{ items | size }}</div>\n                <div class=\"stat-label\">Total Work Items</div>\n            </div>\n{{~ active_items = items | where 'state == \"Active\" || state == \"In Progress\"' ~}}\n            <div class=\"stat-card\">\n                <div class=\"stat-value\">{{ active_items | size }}</div>\n                <div class=\"stat-label\">Active</div>\n            </div>\n{{~ completed_items = items | where 'state == \"Done\" || state == \"Closed\"' ~}}\n            <div class=\"stat-card\">\n                <div class=\"stat-value\">{{ completed_items | size }}</div>\n                <div class=\"stat-label\">Completed</div>\n            </div>\n        </div>\n        <div class=\"section\">\n            <h2><span>\ud83d\udccb</span> Work Items</h2>\n            <div class=\"card\">\n                <table>\n                    <thead>\n                        <tr>\n                            <th>ID</th>\n                            <th>Title</th>\n                            <th>State</th>\n                            <th>Type</th>\n                            <th>Organization</th>\n                            <th>Project</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n{{~ for item in items ~}}\n                        <tr>\n                            <td><a href=\"{{ item.url }}\" target=\"_blank\">{{ item.id }}</a></td>\n                            <td>{{ item.title }}</td>\n                            <td>{{ item.state }}</td>\n                            <td>{{ item.logical_type }}</td>\n                            <td>{{ item.connection.base_url | org_name_from_url }}</td>\n                            <td>{{ item.project }}</td>\n                        </tr>\n{{~ end ~}}\n                    </tbody>\n                </table>\n            </div>\n        </div>\n    </div>\n    <footer class=\"footer\">\n        <AzdwSignature/>\n    </footer>\n</body>\n</html>",
  "outputFormat": "html",
  "mimeType": "text/html",
  "fileExtension": ".html",
  "category": "Dashboards",
  "tags": [
    "dashboard",
    "html",
    "scriban",
    "team",
    "charts"
  ],
  "parameters": {
    "team_name": {
      "name": "team_name",
      "displayName": "Team Name",
      "description": "Name of the team for the dashboard",
      "dataType": "string",
      "isRequired": true,
      "placeholderText": "Development Team"
    }
  },
  "defaultValues": {
    "team_name": "Team"
  },
  "isEnabled": true,
  "isBuiltIn": false,
  "version": "1.2.0",
  "author": "Azure DevOps Work Item Handler Library",
  "supportedDataTypes": [
    "WorkItem[]"
  ],
  "dependencies": [],
  "sampleInput": "Array of work items with properties: id, title, state, work_item_type, assigned_to, changed_date, url"
}