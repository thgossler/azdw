{
  "id": "work-item-analysis-html",
  "name": "Work Item Analysis Review",
  "description": "Offline review and presentation of azdw.work-item-analysis 1.0 documents. Use report generate --template-id work-item-analysis-html --data analysis.json --output review.html. Review decisions are local, unauthenticated annotations; export to retain them. No source-system writes.",
  "engineType": "scriban",
  "outputFormat": "html",
  "mimeType": "text/html",
  "fileExtension": ".html",
  "category": "Analysis",
  "tags": ["analysis", "offline", "review"],
  "isEnabled": true,
  "version": "1.0.0",
  "content": "<!DOCTYPE html>\n<html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><meta http-equiv='Content-Security-Policy' content=\"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'none'; img-src data:; base-uri 'none'; form-action 'none'\"><title>Work Item Analysis</title>\n<style>\n*{box-sizing:border-box;letter-spacing:0}body{margin:0;color:var(--text-primary, #1A1A1A);background:var(--bg-primary, #F5F5F0);font-family:var(--font-primary, 'Merriweather', Georgia, 'Times New Roman', serif);font-size:var(--font-size-base, 16px);line-height:var(--line-height-base, 1.6)}header{background:var(--bg-card, #FAFAF8);border-bottom:3px solid var(--accent-primary, #D97757);padding:var(--padding-2xl, 24px) max(var(--padding-xl, 20px),calc((100% - var(--container-max-width, 900px))/2));display:flex;gap:var(--padding-xl, 20px);justify-content:space-between;align-items:center}h1{font-family:var(--font-secondary, 'Merriweather', Georgia, serif);font-size:var(--font-size-2xl, 2em);line-height:var(--line-height-tight, 1.4);margin:0 0 var(--padding-sm, 8px)}h2{font-size:var(--font-size-xl, 1.4em);margin:0 0 var(--padding-md, 12px)}h3{font-size:var(--font-size-lg, 1.1em);margin:0 0 var(--padding-sm, 8px)}p{margin:var(--padding-sm, 8px) 0}small,.muted{color:var(--text-secondary, #5C5C5C)}main{max-width:var(--container-max-width, 900px);margin:auto;padding:var(--padding-2xl, 24px) var(--padding-xl, 20px)}button,select,input,textarea{font:inherit;color:inherit;max-width:100%}button,select,input{min-height:40px;border:1px solid var(--border-medium, #D4D4CF);border-radius:var(--border-radius-sm, 6px);padding:var(--padding-sm, 8px) var(--padding-md, 12px);background:var(--bg-card, #FAFAF8)}button{cursor:pointer}button:hover{border-color:var(--accent-primary, #D97757)}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--color-info, #4682B4);outline-offset:2px}button[aria-selected=true]{background:var(--accent-primary, #D97757);color:var(--text-inverse, #FFFFFF);border-color:var(--accent-primary, #D97757)}button[aria-pressed=true]{border:2px solid var(--accent-primary, #D97757)}.actions,.tabs{display:flex;flex-wrap:wrap;gap:var(--padding-sm, 8px)}.stats{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border-bottom:1px solid var(--border-medium, #D4D4CF);margin-bottom:var(--padding-lg, 16px)}.stat{padding:var(--padding-md, 12px);border-left:1px solid var(--border-medium, #D4D4CF);min-width:0;overflow-wrap:anywhere}.stat span{font-size:var(--font-size-sm, 0.85em)}.stat strong{display:block;font-family:var(--font-secondary, 'Merriweather', Georgia, serif);font-size:var(--font-size-2xl, 2em)}.notice{background:var(--color-warning-bg, rgba(184,134,11,0.1));padding:var(--padding-md, 12px) var(--padding-lg, 16px);border-left:4px solid var(--color-warning, #B8860B);margin-bottom:var(--padding-xl, 20px);overflow-wrap:anywhere}.tabs{margin:var(--padding-xl, 20px) 0}.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,14em),1fr));gap:var(--padding-md, 12px);padding:var(--padding-lg, 16px) 0;border-top:1px solid var(--border-medium, #D4D4CF);border-bottom:1px solid var(--border-medium, #D4D4CF)}label{display:block;font-size:var(--font-size-sm, 0.85em);font-weight:600}label input,label select{display:block;width:100%;margin-top:var(--padding-xs, 4px)}article{padding:var(--padding-2xl, 24px) 0;border-bottom:1px solid var(--border-medium, #D4D4CF);overflow-wrap:anywhere;break-inside:avoid}.heading{display:flex;justify-content:space-between;gap:var(--padding-lg, 16px);align-items:start}.badge{display:inline-block;border-radius:var(--border-radius-sm, 6px);background:var(--accent-primary-light, rgba(217,119,87,0.1));color:var(--accent-primary, #D97757);padding:var(--padding-xs, 4px) var(--padding-sm, 8px);font-size:var(--font-size-xs, 0.75em);font-weight:700}.comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--padding-2xl, 24px);margin:var(--padding-lg, 16px) 0}.item{border-left:3px solid var(--color-info, #4682B4);padding-left:var(--padding-lg, 16px);min-width:0}.item:nth-child(even){border-color:var(--accent-primary, #D97757)}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-family:var(--font-mono, 'SF Mono', Monaco, Consolas, monospace);font-size:var(--font-size-md, 0.9em);margin:var(--padding-xs, 4px) 0;max-width:100%}details{margin:var(--padding-md, 12px) 0}summary{cursor:pointer;font-weight:600}.decision{display:grid;grid-template-columns:180px minmax(0,1fr);gap:var(--padding-lg, 16px);align-items:start;margin-top:var(--padding-lg, 16px)}textarea{width:100%;min-height:76px;resize:vertical;border:1px solid var(--border-medium, #D4D4CF);border-radius:var(--border-radius-sm, 6px);padding:var(--padding-sm, 8px);background:var(--bg-card, #FAFAF8)}ul{padding-left:var(--padding-2xl, 24px)}.empty{padding:var(--padding-3xl, 32px) 0;color:var(--text-secondary, #5C5C5C)}[hidden]{display:none!important}#feedback{color:var(--color-error, #cc293d);min-height:24px;margin:var(--padding-sm, 8px) 0}footer{padding:var(--padding-xl, 20px);border-top:1px solid var(--border-medium, #D4D4CF);font-size:var(--font-size-sm, 0.85em)}.presentation header{position:sticky;top:0;z-index:1}.presentation .filters,.presentation .decision{display:none}.presentation article{padding:var(--padding-3xl, 32px) 0}.presentation .item{font-size:var(--font-size-lg, 1.1em)}@media(max-width:760px){header{display:block;padding:var(--padding-xl, 20px)}.actions{margin-top:var(--padding-lg, 16px)}.stats{grid-template-columns:repeat(3,minmax(0,1fr))}.filters{grid-template-columns:1fr}.filters label:first-child{grid-column:1/-1}.comparison,.decision{grid-template-columns:1fr}.heading{display:block}h1{font-size:var(--font-size-xl, 1.4em)}}@media print{header{position:static!important}.actions,.tabs,.filters,.decision,#feedback{display:none!important}body{background:var(--bg-card, #FAFAF8)}main{padding:var(--padding-md, 12px)}.stats{grid-template-columns:repeat(6,minmax(0,1fr))}article{break-inside:avoid}.comparison{grid-template-columns:repeat(2,minmax(0,1fr))}}\n</style></head><body>\n<header><div><h1>Work Item Analysis</h1><small id='identity'></small></div><div class='actions'><button id='presentation' aria-pressed='false'>Presentation</button><button id='print'>Print</button><button id='export'>Export decisions</button><button id='import'>Import decisions</button><input id='import-file' type='file' accept='.json,application/json' hidden></div></header>\n<main><section id='stats' class='stats' aria-label='Summary'></section><section class='notice'><strong id='coverage-label'></strong><details><summary>Coverage, warnings and errors</summary><div id='warnings'></div><pre id='coverage'></pre></details></section><div class='tabs' role='tablist' aria-label='Analysis views'><button role='tab' id='tab-review' aria-controls='review' aria-selected='true'>Review</button><button role='tab' id='tab-clusters' aria-controls='clusters' aria-selected='false'>Clusters</button><button role='tab' id='tab-context' aria-controls='context' aria-selected='false'>Configuration &amp; context</button></div><p id='feedback' role='status' aria-live='polite'></p>\n<section id='review' role='tabpanel' aria-labelledby='tab-review'><div class='filters'><label>Search<input id='search' type='search' placeholder='Title, key, evidence or reason'></label><label>Classification<select id='classification'><option value=''>All classifications</option></select></label><label>Review status<select id='status'><option value=''>All statuses</option><option>unreviewed</option><option>accepted</option><option>rejected</option><option>deferred</option></select></label><label>Work item type<select id='type'><option value=''>All types</option></select></label><label>Connection<select id='connection'><option value=''>All connections</option></select></label></div><p id='result-count' class='muted'></p><div id='records'></div><details><summary>Observed relationships</summary><div id='observed'></div></details><details><summary>Policy findings</summary><div id='policy'></div></details></section>\n<section id='clusters' role='tabpanel' aria-labelledby='tab-clusters' hidden></section><section id='context' role='tabpanel' aria-labelledby='tab-context' hidden><h2>Captured configuration</h2><div id='configuration'></div></section></main><footer>Read-only snapshot. Decisions and notes exist only in this page's memory until exported. Imported annotations are not authenticated audit records and never authorize upstream changes.</footer>\n<script id='analysis-data' type='application/json'>{{ analysis_json }}</script>\n<script>\n'use strict';\nconst analysis=JSON.parse(document.getElementById('analysis-data').textContent);\nconst fingerprint='{{ analysis_fingerprint }}';\nconst byId=id=>document.getElementById(id);\nconst items=new Map(analysis.workItems.map(item=>[item.key,item]));\nconst evidence=new Map(analysis.evidence.map(entry=>[entry.id,entry]));\nconst statuses=['unreviewed','accepted','rejected','deferred'];\nlet decisions=new Map();\nconst records=[...analysis.pairAssessments.map(pair=>({key:'pair:'+pair.id,kind:pair.classification,members:[pair.sourceKey,pair.targetKey],record:pair})),...analysis.relationshipProposals.map(proposal=>({key:'relationship:'+proposal.id,kind:'relationship-proposal',members:[proposal.sourceKey,proposal.targetKey],record:proposal})),...analysis.consolidationProposals.map(proposal=>({key:'consolidation:'+proposal.id,kind:'consolidation-proposal',members:proposal.memberKeys,record:proposal}))];\nconst known=new Set(records.map(entry=>entry.key));\nfunction node(tag,text,className){const element=document.createElement(tag);if(text!==undefined)element.textContent=String(text);if(className)element.className=className;return element;}\nfunction lines(parent,values){const list=node('ul');for(const value of values)list.append(node('li',value));parent.append(list);}\nfunction block(parent,title,value){const section=node('details');section.append(node('summary',title),node('pre',typeof value==='string'?value:JSON.stringify(value,null,2)));parent.append(section);}\nfunction decisionFor(key){return decisions.get(key)||{status:'unreviewed',notes:''};}\nfunction stats(){const host=byId('stats');host.replaceChildren();for(const [label,value] of [['Work items',items.size],['Pairs',analysis.pairAssessments.length],['Proposals',analysis.relationshipProposals.length+analysis.consolidationProposals.length],['Clusters',analysis.clusters.length],['AI assessed',analysis.coverage.aiAssessedPairs],['Reviewed',[...decisions.values()].filter(value=>value.status!=='unreviewed').length]]){const stat=node('div',undefined,'stat');stat.append(node('strong',value),node('span',label));host.append(stat);}}\nfunction itemPanel(key){const item=items.get(key);const panel=node('section',undefined,'item');panel.append(node('small',key),node('h3',item.title),node('p',item.logicalTypeDisplayName+' / '+item.state+' / '+item.connection));block(panel,'Description',item.description||'(not captured)');block(panel,'Acceptance criteria',item.acceptanceCriteria||'(not captured)');block(panel,'Snapshot details',{physicalType:item.physicalType,logicalType:item.logicalType,typeResolution:item.typeResolution,revision:item.revision,modifiedAt:item.modifiedAt,tags:item.tags,contentHash:item.contentHash,textTruncated:item.textTruncated});return panel;}\nfunction visible(entry){const query=byId('search').value.toLowerCase();const classification=byId('classification').value;const status=byId('status').value;const type=byId('type').value;const connection=byId('connection').value;return(!classification||entry.kind===classification)&&(!status||decisionFor(entry.key).status===status)&&(!type||entry.members.some(key=>items.get(key).logicalType===type))&&(!connection||entry.members.some(key=>items.get(key).connection===connection))&&(!query||JSON.stringify([entry,entry.members.map(key=>items.get(key)),(entry.record.evidenceIds||[]).map(id=>evidence.get(id))]).toLowerCase().includes(query));}\nfunction render(){stats();const host=byId('records');host.replaceChildren();const selected=records.filter(visible);byId('result-count').textContent=selected.length+' of '+records.length+' review entries';if(!selected.length)host.append(node('p','No review entries match these filters.','empty'));for(const entry of selected){const record=entry.record;const article=node('article');article.dataset.reviewKey=entry.key;const heading=node('div',undefined,'heading');heading.append(node('h2',entry.kind),node('span',decisionFor(entry.key).status,'badge'));article.append(heading,node('small',entry.key),node('p',record.reason));if(record.retrievalScore!==undefined)article.append(node('p','Lexical retrieval score: '+record.retrievalScore.toFixed(3)+' (not semantic confidence)','muted'));if(record.survivorKey)article.append(node('p','Proposed survivor: '+record.survivorKey));if(record.relationshipType)article.append(node('p','Proposed link: '+record.relationshipType+' / '+record.direction+' / '+record.realization));const comparison=node('div',undefined,'comparison');for(const key of entry.members)comparison.append(itemPanel(key));article.append(comparison);if(record.differences?.length)block(article,'Differences',record.differences);if(record.conflicts?.length)block(article,'Conflicts',record.conflicts);const citations=node('details');citations.append(node('summary','Evidence ('+(record.evidenceIds||[]).length+')'));for(const id of record.evidenceIds||[]){const citation=evidence.get(id);citations.append(node('p',citation.itemKey+' / '+citation.field),node('pre',citation.excerpt),node('small','Snapshot hash: '+citation.contentHash));}article.append(citations);const controls=node('div',undefined,'decision');const statusLabel=node('label','Decision');const select=node('select');select.setAttribute('aria-label','Decision for '+entry.key);for(const status of statuses){const option=node('option',status);option.value=status;select.append(option);}select.value=decisionFor(entry.key).status;statusLabel.append(select);const notesLabel=node('label','Local notes');const notes=node('textarea');notes.setAttribute('aria-label','Notes for '+entry.key);notes.maxLength=20000;notes.value=decisionFor(entry.key).notes;notesLabel.append(notes);select.addEventListener('change',()=>{decisions.set(entry.key,{status:select.value,notes:notes.value});render();});notes.addEventListener('input',()=>{decisions.set(entry.key,{status:select.value,notes:notes.value});});controls.append(statusLabel,notesLabel);article.append(controls);host.append(article);}}\nfunction populate(id,values){for(const value of [...new Set(values)].sort()){const option=node('option',value);option.value=value;byId(id).append(option);}}\nbyId('identity').textContent=analysis.analysisId+' / '+analysis.completedAt;\nbyId('coverage-label').textContent='Source completeness: '+analysis.coverage.sourceCompleteness+' | Guidance: '+analysis.coverage.guidanceStatus+(analysis.coverage.timedOut?' | Time budget reached':'');\nlines(byId('warnings'),[...analysis.warnings,...analysis.errors,...['itemBudgetReached','scanBudgetReached','pairBudgetReached'].filter(key=>analysis.coverage[key]).map(key=>key+': true')]);byId('coverage').textContent=JSON.stringify(analysis.coverage,null,2);\npopulate('classification',records.map(entry=>entry.kind));populate('type',analysis.workItems.map(item=>item.logicalType));populate('connection',analysis.workItems.map(item=>item.connection));\nfor(const id of ['search','classification','status','type','connection'])byId(id).addEventListener(id==='search'?'input':'change',render);\nfor(const view of ['review','clusters','context'])byId('tab-'+view).addEventListener('click',()=>{for(const other of ['review','clusters','context']){byId(other).hidden=other!==view;byId('tab-'+other).setAttribute('aria-selected',String(other===view));}});\nbyId('clusters').append(node('h2','Pair-backed clusters'));if(!analysis.clusters.length)byId('clusters').append(node('p','No clusters in this snapshot.','empty'));for(const cluster of analysis.clusters){const article=node('article');article.append(node('h3',cluster.kind),node('p',cluster.id+' / '+cluster.method+' / Cohesion: '+cluster.cohesion),node('p','Representative: '+cluster.representativeKey));lines(article,cluster.memberKeys.map(key=>key+': '+items.get(key).title));block(article,'Supporting assessments',cluster.assessmentIds);byId('clusters').append(article);}\nfor(const [title,value] of [['Per-run guidance',analysis.scope.analysisGuidance||'(not supplied)'],['Glossary',analysis.effectiveConfiguration.glossary||'(unavailable)'],['Effective configuration',analysis.effectiveConfiguration],['Selection scope',analysis.scope]])block(byId('configuration'),title,value);\nfor(const edge of analysis.observedRelationships){const article=node('article');article.append(node('p',edge.sourceKey+' -> '+(edge.targetKey||edge.targetUrl||'(unresolved)')),node('p','Observed: '+(edge.semanticType||edge.originalType)+' / '+edge.origin+' / '+edge.resolution));byId('observed').append(article);}if(!analysis.observedRelationships.length)byId('observed').append(node('p','No observed relationships.'));\nfor(const finding of analysis.policyFindings)block(byId('policy'),finding.itemKey+' / '+finding.status,finding);if(!analysis.policyFindings.length)byId('policy').append(node('p','No policy findings.'));\nbyId('presentation').addEventListener('click',()=>{const active=document.body.classList.toggle('presentation');byId('presentation').setAttribute('aria-pressed',String(active));});byId('print').addEventListener('click',()=>print());\nbyId('export').addEventListener('click',()=>{const payload={documentType:'azdw.work-item-analysis-decisions',schemaVersion:'1.0',analysisId:analysis.analysisId,analysisFingerprint:fingerprint,decisions:[...decisions].map(([id,value])=>({id,...value}))};const url=URL.createObjectURL(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}));const link=node('a');link.href=url;link.download='analysis-decisions.json';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});\nbyId('import').addEventListener('click',()=>byId('import-file').click());\nbyId('import-file').addEventListener('change',async event=>{try{const file=event.target.files[0];if(!file)return;if(file.size>5000000)throw new Error('Decision file exceeds 5 MB.');const payload=JSON.parse(await file.text());if(payload.documentType!=='azdw.work-item-analysis-decisions'||payload.schemaVersion!=='1.0'||payload.analysisId!==analysis.analysisId||payload.analysisFingerprint!==fingerprint||!Array.isArray(payload.decisions))throw new Error('Decision file does not match this analysis ID, fingerprint or schema.');const imported=new Map();for(const value of payload.decisions){if(!value||!known.has(value.id)||imported.has(value.id)||!statuses.includes(value.status)||typeof value.notes!=='string'||value.notes.length>20000)throw new Error('Invalid or duplicate decision entry.');imported.set(value.id,{status:value.status,notes:value.notes});}decisions=imported;render();byId('feedback').textContent='Imported '+imported.size+' local annotations; not authenticated audit records.';}catch(error){byId('feedback').textContent=error.message;}finally{event.target.value='';}});\nrender();\n</script></body></html>"
}