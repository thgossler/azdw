{
  "id": "sprint-retro-html",
  "name": "Sprint Retrospective Report",
  "description": "A sprint retrospective report showing work items completed, in progress, and blocked with key metrics.",
  "engineType": "scriban",
  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{{ parameters.title | default 'Sprint Retrospective Report' }}</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Merriweather:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root { --bg-primary: #F5F5F0; --bg-card: #FAFAF8; --text-primary: #1A1A1A; --text-secondary: #5C5C5C; --text-muted: #8C8C8C; --accent-coral: #D97757; --accent-coral-hover: #C4613F; --border-light: #E5E5E0; }\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: 'Merriweather', Georgia, serif; background: var(--bg-primary); color: var(--text-primary); padding: 40px 20px; line-height: 1.6; }\n.container { max-width: 900px; margin: 0 auto; }\nh1 { font-size: 2em; color: var(--text-primary); margin-bottom: 16px; }\nh2 { font-size: 1.4em; color: var(--text-primary); margin: 24px 0 12px; display: flex; align-items: center; gap: 10px; }\ncard { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 12px; padding: 24px; margin-bottom: 20px; }\ntable { width: 100%; border-collapse: collapse; margin: 16px 0; }\nth, td { padding: 12px 8px; text-align: left; border-bottom: 1px solid var(--border-light); }\nth { background: var(--bg-card); font-weight: 600; color: var(--text-secondary); font-size: 0.85em; text-transform: uppercase; }\ntr:hover { background: var(--bg-card); }\na { color: var(--accent-coral); text-decoration: none; }\na:hover { text-decoration: underline; }\n.stat-value { font-size: 2em; font-weight: 600; color: var(--accent-coral); }\n.stat-label { font-size: 0.85em; color: var(--text-secondary); }\n.footer { border-top: 1px solid var(--border-light); padding: 40px 0; text-align: center; margin-top: 40px; }\n.info-block { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 12px; padding: 24px; font-family: monospace; font-size: 0.85em; color: var(--text-secondary); display: inline-block; text-align: left; white-space: pre-wrap; }\n</style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Sprint Retrospective Report</h1>\n        <p>Generated: {{ timestamp | format_date 'yyyy-MM-dd HH:mm:ss UTC' }}</p>\n        <p>Total Work Items: {{ items | size }} items</p>\n        <footer class=\"footer\">\n            <AzdwSignature/>\n        </footer>\n    </div>\n    <div class=\"container\">\n        <h2>Work Item Summary</h2>\n        <table>\n            <thead>\n                <tr>\n                    <th>Status</th>\n                    <th>Count</th>\n                </tr>\n            </thead>\n            <tbody>\n{{~ active_bugs = items | where 'logical_type == \"Bug\"' | where 'state == \"Active\"' ~}}\n{{~ completed_items = items | where 'state == \"Completed\"' ~}}\n{{~ blocked_items = items | where 'state == \"Blocked\"' ~}}\n                <tr>\n                    <td>Completed</td>\n                    <td>{{ completed_items | size }}</td>\n                </tr>\n                <tr>\n                    <td>In Progress</td>\n                    <td>{{ active_bugs | size }}</td>\n                </tr>\n                <tr>\n                    <td>Blocked</td>\n                    <td>{{ blocked_items | size }}</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    <div class=\"container\">\n        <h2>Completed Items</h2>\n        <div class=\"card\">\n            <table>\n                <thead>\n                    <tr>\n                        <th>ID</th>\n                        <th>Title</th>\n                        <th>State</th>\n                    </tr>\n                </thead>\n                <tbody>\n{{~ for item in completed_items ~}}\n                    <tr>\n                        <td><a href=\"{{ item.url }}\" target=\"_blank\">{{ item.id }}</a></td>\n                        <td>{{ item.title }}</td>\n                        <td>{{ item.state }}</td>\n                    </tr>\n{{~ end ~}}\n                </tbody>\n            </table>\n        </div>\n    </div>\n    <div class=\"container\">\n        <h2>In Progress Items</h2>\n        <div class=\"card\">\n            <table>\n                <thead>\n                    <tr>\n                        <th>ID</th>\n                        <th>Title</th>\n                        <th>State</th>\n                    </tr>\n                </thead>\n                <tbody>\n{{~ for item in active_bugs ~}}\n                    <tr>\n                        <td><a href=\"{{ item.url }}\" target=\"_blank\">{{ item.id }}</a></td>\n                        <td>{{ item.title }}</td>\n                        <td>{{ item.state }}</td>\n                    </tr>\n{{~ end ~}}\n                </tbody>\n            </table>\n        </div>\n    </div>\n    <div class=\"container\">\n        <h2>Blocked Items</h2>\n        <div class=\"card\">\n            <table>\n                <thead>\n                    <tr>\n                        <th>ID</th>\n                        <th>Title</th>\n                        <th>State</th>\n                    </tr>\n                </thead>\n                <tbody>\n{{~ for item in blocked_items ~}}\n                    <tr>\n                        <td><a href=\"{{ item.url }}\" target=\"_blank\">{{ item.id }}</a></td>\n                        <td>{{ item.title }}</td>\n                        <td>{{ item.state }}</td>\n                    </tr>\n{{~ end ~}}\n                </tbody>\n            </table>\n        </div>\n    </div>\n</body>\n</html>",
  "outputFormat": "html",
  "mimeType": "text/html",
  "fileExtension": ".html",
  "category": "AI Generated",
  "tags": ["ai-generated"],
  "isEnabled": true,
  "version": "1.0.0"
}