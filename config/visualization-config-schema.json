{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Visualization Configuration",
  "description": "Configuration for customizing work item relationship visualizations",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Configuration schema version (e.g., '1.0'). Used for migration between schema versions.",
      "default": "1.0"
    },
    "organizations": {
      "type": "object",
      "description": "Color mappings for organizations",
      "patternProperties": {
        "^.*$": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color code for organization background"
        }
      },
      "additionalProperties": false
    },
    "workItemTypes": {
      "type": "object",
      "description": "Color mappings for work item types",
      "patternProperties": {
        "^.*$": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color code for work item type"
        }
      },
      "additionalProperties": false
    },
    "relationshipTypes": {
      "type": "object",
      "description": "Color mappings for relationship types",
      "patternProperties": {
        "^.*$": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color code for relationship type"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
