{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thgossler/azdw/config/remote-mcp-schema.json",
  "title": "azdw Remote MCP configuration",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "tenantId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "properties": {
    "RemoteMcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CanonicalResourceUri",
        "McpPath",
        "AuthorizationServers",
        "RequiredScopes"
      ],
      "properties": {
        "CanonicalResourceUri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^#]+$"
        },
        "McpPath": {
          "type": "string",
          "pattern": "^/[^?#]*$",
          "default": "/mcp"
        },
        "ResourceName": {
          "type": "string",
          "minLength": 1
        },
        "TenantId": {
          "$ref": "#/$defs/tenantId"
        },
        "ServerClientId": {
          "type": "string",
          "minLength": 1
        },
        "AllowMultiTenant": {
          "type": "boolean",
          "default": false
        },
        "AllowedTenantIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tenantId"
          }
        },
        "AuthorizationServers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://[^#]+$"
          }
        },
        "RequiredScopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "AuthorizationScopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ValidAudiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "AzureDevOpsScope": {
          "type": "string",
          "minLength": 1,
          "default": "499b84ac-1321-427f-aa17-267ca6975798/.default"
        },
        "EnableOnBehalfOf": {
          "type": "boolean",
          "default": true
        },
        "OnBehalfOfClientSecret": {
          "type": "string",
          "writeOnly": true
        },
        "ManagedIdentityClientId": {
          "type": "string"
        },
        "KnownClientIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "AllowClientIdMetadataDocuments": {
          "type": "boolean",
          "default": false
        },
        "AllowedClientMetadataHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "AllowDynamicClientRegistration": {
          "type": "boolean",
          "default": false
        },
        "AllowBearerFallback": {
          "type": "boolean",
          "default": true
        },
        "RequireDpop": {
          "type": "boolean",
          "default": false
        },
        "AllowUnsignedDevelopmentTokens": {
          "type": "boolean",
          "default": false
        },
        "TrustedProxyNetworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "BlockedMetadataHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["AllowMultiTenant"],
            "properties": {
              "AllowMultiTenant": {
                "const": true
              }
            }
          },
          "then": {
            "required": ["TenantId", "AllowedTenantIds"],
            "properties": {
              "TenantId": {
                "$ref": "#/$defs/tenantId"
              },
              "AllowedTenantIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/tenantId"
                }
              },
              "AuthorizationServers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^https://login\\.microsoftonline\\.com/(common|organizations|\\{tenantId\\}|\\{tenant\\})/v2\\.0$"
                }
              }
            }
          }
        }
      ]
    }
  }
}